local function SendNotification(text)
    if GUI and GUI:FindFirstChild("Notification") then
        local notif = GUI.Notification
        notif.TextLabel.Text = text
        notif.Visible = true
        wait(1.5)
        notif.Visible = false
    end
end

-- // Funciones de juego (exploits)
local function getClosestEnemyToCamera(maxDistance)
    local closest = nil
    local shortestDist = maxDistance or math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Team ~= LP.Team and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

local function killPlayer(plr)
    if not ShootRemote then return end
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum and hum.Health > 0 then
            -- Fire remote 5 veces para asegurar kill (por si hay lag)
            for _=1,5 do
                pcall(function() ShootRemote:FireServer(hum) end)
            end
        end
    end
end

local function killAllEnemies()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Team ~= LP.Team then
            killPlayer(plr)
        end
    end
end

-- // ESP (via Drawing)
local ESPObjects = {}
local function toggleESP(state)
    if state then
        -- Crea dibujos para cada jugador enemigo
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Team ~= LP.Team then
                local box = Drawing.new("Square")
                box.Color = Color3.fromRGB(255,0,0)
                box.Thickness = 2
                box.Filled = false
                box.Visible = true
                local line = Drawing.new("Line")
                line.Color = Color3.fromRGB(255,0,0)
                line.Thickness = 1
                line.Visible = true
                local text = Drawing.new("Text")
                text.Color = Color3.fromRGB(255,255,255)
                text.Size = 14
                text.Center = true
                text.Outline = true
                text.Visible = true
                ESPObjects[plr] = {box=box, line=line, text=text}
            end
        end
        -- Update en loop
        spawn(function()
            while Features.ESP do
                for plr, objs in pairs(ESPObjects) do
                    if plr.Parent and plr.Character then
                        local head = plr.Character:FindFirstChild("Head")
                        local root = plr.Character:FindFirstChild("HumanoidRootPart")
                        local hum = plr.Character:FindFirstChildWhichIsA("Humanoid")
                        if head and root and hum then
                            local headPos = Camera:WorldToViewportPoint(head.Position)
                            local rootPos = Camera:WorldToViewportPoint(root.Position)
                            if rootPos.onScreen then
                                local screenPos = Vector2.new(headPos.X, headPos.Y)
                                local screenRoot = Vector2.new(rootPos.X, rootPos.Y + 3)
                                objs.box.Position = Vector2.new(screenPos.X-20, screenPos.Y-40)
                                objs.box.Size = Vector2.new(40, 60)
                                objs.line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                                objs.line.To = screenRoot
                                objs.text.Position = Vector2.new(screenPos.X, screenPos.Y-45)
                                objs.text.Text = string.format("%s [%d]", plr.Name, math.floor(hum.Health))
                            end
                        end
                    end
                end
                wait()
            end
        end)
    else
        for _, objs in pairs(ESPObjects) do
            if objs.box then objs.box:Remove() end
            if objs.line then objs.line:Remove() end
            if objs.text then objs.text:Remove() end
        end
        ESPObjects = {}
    end
end

-- // Funciones de movimiento
local function setSpeed(val)
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.WalkSpeed = val
        end
    end
end

local flyBodyGyro = nil
local flyBodyVel = nil
local function toggleFly(state)
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if state then
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(400000,400000,400000)
        flyBodyGyro.P = 30000
        flyBodyGyro.Parent = root
        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.MaxForce = Vector3.new(400000,400000,400000)
        flyBodyVel.Velocity = Vector3.new(0,0,0)
        flyBodyVel.Parent = root
        -- Controles
        local flyLoop
        flyLoop = RunService.RenderStepped:Connect(function()
            if not Features.Fly then flyLoop:Disconnect() return end
            if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
            flyBodyGyro.CFrame = Camera.CFrame
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0,1,0) end
            flyBodyVel.Velocity = moveDir.unit * Features.FlySpeed
        end)
    else
        if flyBodyGyro then flyBodyGyro:Destroy() end
        if flyBodyVel then flyBodyVel:Destroy() end
        flyBodyGyro = nil
        flyBodyVel = nil
    end
end

local function toggleNoclip(state)
    if state then
        local noclipCon = RunService.Stepped:Connect(function()
            if not Features.Noclip then noclipCon:Disconnect() return end
            if LP.Character then
                for _, v in pairs(LP.Character:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then
                        v.CanCollide = false
                    end
                end
            end
        end)
    else
        if LP.Character then
            for _, v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsA("Terrain") then
                    v.CanCollide = true
                end
            end
        end
    end
end

-- // Aimbot
local function aimbot()
    if not Features.Aimbot then return end
    if not UserInputService:IsKeyDown(Features.AimbotKey) then return end
    local target = getClosestEnemyToCamera(Features.AimbotFOV)
    if target and target.Character then
        local head = target.Character:FindFirstChild("Head")
        if head then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
            if Features.AutoShoot then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, nil, 0) -- Mouse1 down
                wait(0.1)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, nil, 0)
            end
            if Features.SilentAim then
                -- Silent aim: cambia temporalmente la posición de la cabeza para el disparo
                -- (simplificado, solo funciona en algunos juegos)
                pcall(function()
                    local oldPos = head.Position
                    head.CFrame = CFrame.new(Camera.CFrame.Position) -- mover cabeza al jugador
                    killPlayer(target)
                    head.CFrame = CFrame.new(oldPos)
                end)
            end
        end
    end
end

-- // Loop principal de hacks
spawn(function()
    while true do
        if Features.Aimbot then
